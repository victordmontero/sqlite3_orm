INCLUDES += -I../../include -I../../thirdparty/sqlite -I../../thirdparty/gtest/googletest/include
FORCE_INCLUDE +=
ALL_CPPFLAGS += $(CPPFLAGS) -MD -MP $(DEFINES) $(INCLUDES)
ALL_RESFLAGS += $(RESFLAGS) $(DEFINES) $(INCLUDES)
LIBS += -lgtest -lgtest_main -lgmock -lgmock_main
LDDEPS +=
LINKCMD = $(CXX) -o "$@" $(OBJECTS) $(RESOURCES) $(ALL_LDFLAGS) $(LIBS)
define PREBUILDCMDS
endef
define PRELINKCMDS
endef
define POSTBUILDCMDS
endef

ifeq ($(config),debug_win32)
TARGETDIR = ../../bin/Debug
TARGET = $(TARGETDIR)/ut_tests.exe
OBJDIR = ../../obj/Win32/Debug
DEFINES += -DDEBUG -DWIN32
ALL_CFLAGS += $(CFLAGS) $(ALL_CPPFLAGS) -m32 -g -w
ALL_CXXFLAGS += $(CXXFLAGS) $(ALL_CPPFLAGS) -m32 -g -w -std=c++14
ALL_LDFLAGS += $(LDFLAGS) -L../../thirdparty/gtest/build/lib/Debug -L/usr/lib32 -m32

else ifeq ($(config),debug_win64)
